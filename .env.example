# Retell AI Configuration
REACT_APP_RETELL_API_KEY=your_retell_api_key_here
REACT_APP_RETELL_AGENT_ID=your_retell_agent_id_here

# API base URL for backend (health + /api/retell/start).
# - Leave empty or omit when the app is served from the same host as the API (e.g. Docker at :4000) to avoid CORS.
# - Set to full URL only when frontend runs on a different origin (e.g. dev: frontend :3000, backend :4000).
# Examples: http://localhost:4000  or  https://hotline.jemwealth.co  or leave empty for same-origin
REACT_APP_API_BASE_URL=
REACT_APP_RETELL_API_URL=https://api.retellai.com/v1

# Optional: Development settings
REACT_APP_ENVIRONMENT=development
